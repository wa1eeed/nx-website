# NX Partners backend — copy to .env and fill real values in production.
NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgres://localhost:5432/nx_partners

# Secrets — GENERATE STRONG RANDOM VALUES IN PRODUCTION (e.g. `openssl rand -base64 48`)
SESSION_SECRET=dev-session-secret-change-me
IP_SALT=dev-ip-salt-change-me
WEBHOOK_SECRET=dev-webhook-secret-change-me

# Where the marketing site lives (for CORS + click redirects). No trailing slash.
PUBLIC_ORIGIN=https://nx.sa

# Optional: restrict session cookie to a domain (e.g. .nx.sa to share across subdomains)
# COOKIE_DOMAIN=.nx.sa

# Attribution / program defaults (can be overridden in the admin settings table)
ATTRIBUTION_WINDOW_DAYS=60

# Seed admin + demo partner passwords (used by `npm run seed` only)
SEED_ADMIN_EMAIL=admin@nx.sa
SEED_ADMIN_PASSWORD=change-me-admin
SEED_PARTNER_EMAIL=khalid@rawnaq.sa
SEED_PARTNER_PASSWORD=change-me-partner
